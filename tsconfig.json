{
  "extends": "@grafana/tsconfig",
  "compilerOptions": {
    "rootDir": "./src",
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "jest",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "types/*": [
        "./src/types/*"
      ]
    },
    "target": "ES2018",
    "lib": [
      "ES2018",
      "dom"
    ],
    "jsx": "react",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
