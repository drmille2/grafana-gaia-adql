{
  "name": "grafana-gaia-adql",
  "version": "0.1.0",
  "description": "Grafana data source plugin for querying the Gaia astronomical catalog using ADQL",
  "scripts": {
    "build": "webpack -c webpack.config.js --env production",
    "dev": "webpack -c webpack.config.js --env development --watch",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:ci": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "David Miller",
  "license": "Apache-2.0",
  "dependencies": {
    "@grafana/data": "11.0.0",
    "@grafana/runtime": "11.0.0",
    "@grafana/schema": "11.0.0",
    "@grafana/ui": "11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/tsconfig": "^2.0.0",
    "@swc/core": "^1.3.62",
    "@swc/helpers": "^0.5.1",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.12",
    "@types/react-dom": "^18.2.5",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.42.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.3.3",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^3.0.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.63.6",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "webpack": "^5.86.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2"
